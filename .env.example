# ==================================================================
#  StudyPalace — environment variables
#  Copy this file to `.env.local` and fill in your real values.
#  NEVER commit `.env.local` to git (it is already git-ignored).
# ==================================================================

# ---------- 1. SITE ----------
# Must be the real public URL. Used for SEO canonicals, sitemap.xml,
# Open Graph images and Razorpay callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=StudyPalace

# ---------- 2. ADMIN LOGIN (only YOU can access /admin) ----------
# Change these! If ADMIN_PASSWORD is left blank the app falls back to
# "changeme123" and the admin panel shows you a loud red warning.
#
# ⚠ IMPORTANT — always wrap the password in DOUBLE QUOTES.
# Next.js treats an unquoted "#" as the start of a comment, so
#   ADMIN_PASSWORD=My#Pass123   silently becomes "My"  and you cannot log in.
# Quotes also protect spaces and other special characters.
ADMIN_EMAIL="admin@studypalace.in"
ADMIN_PASSWORD="ChangeThisToSomethingLong_2027"

# Secret used to sign the admin session cookie + download links.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="paste-your-64-character-random-string-here"

# ---------- 3. RAZORPAY ----------
# Dashboard -> Settings -> API Keys -> Generate Test Key  (for testing)
# Dashboard -> Settings -> API Keys -> Generate Live Key  (for real money)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional but recommended: Dashboard -> Webhooks -> add
#   https://yourdomain.com/api/razorpay/webhook   event: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Currency + how much is discounted/charged. Razorpay works in the
# smallest unit (paise for INR), so 199 INR = 19900.
CURRENCY=INR

# ---------- 4. STORAGE ----------
# Where uploaded PDFs live. Keep it OUTSIDE the public/ folder so files
# can only be reached through a verified, paid download link.
UPLOAD_DIR=./uploads
# Max upload size in MB
MAX_UPLOAD_MB=60

# Optional: if you later move to Vercel/S3, set this to the public base
# URL of your bucket and files will be served from there instead.
# PUBLIC_ASSET_BASE_URL=

# ---------- 5. DATABASE ----------
# SQLite (default — zero setup, perfect for a VPS / local machine):
# DATABASE_URL=file:./data/studypalace.db
# Postgres (only needed for serverless hosts like Vercel):
# DATABASE_URL=postgres://user:pass@host:5432/db

# ---------- 6. OPTIONAL ----------
# Shown in the footer + contact page
SUPPORT_EMAIL=support@studypalace.in
SUPPORT_WHATSAPP="919999999999"
# Google Analytics / Plausible measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
